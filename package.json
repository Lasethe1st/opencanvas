{
  "name": "opencanvas",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight desktop visual development environment for React projects.",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:browser": "vite --config vite.config.ts --port 5199 --strictPort",
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node scripts/build-electron.mjs && node --test \"tests/*.test.mjs\"",
    "test:e2e": "npm run build && node tests/e2e/run.mjs",
    "lint:lime": "node scripts/lime-eslint.mjs ."
  },
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "@base-ui/react": "^1.9.0",
    "@carbon/icons-react": "^11.91.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.54.0",
    "monaco-editor": "^0.57.0",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.0",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2"
  }
}
