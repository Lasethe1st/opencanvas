{
  "name": "opencanvas",
  "version": "0.1.0",
  "private": true,
  "description": "A lightweight desktop visual development environment for React projects.",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node scripts/build-electron.mjs && node --test \"tests/*.test.mjs\"",
    "test:e2e": "npm run build && node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "@monaco-editor/react": "^4.7.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.54.0",
    "monaco-editor": "^0.57.0",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.7.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "typescript": "^7.0.2"
  }
}
